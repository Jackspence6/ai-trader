# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
.next/
/out/
/build
/coverage
tsconfig.tsbuildinfo
*.tsbuildinfo
.vercel

# next-env.d.ts is generated, and tracking it was a mistake I made earlier in
# this pass. Two reasons it is ignored again:
#
#   * `next build` rewrites it to point at whichever distDir was just built, so
#     every build dirtied the working tree. The auto-updater refuses to pull
#     over a dirty tree -- correctly -- which meant the deployment box would
#     have updated once and then silently never again.
#   * The justification for tracking it was that a clean checkout should
#     typecheck before anything is built. That was asserted, not tested, and it
#     is false: `tsc --noEmit` passes without the file.
next-env.d.ts

# Local runtime state: engine config, the credential vault (encrypted, but
# never commit it), the paper book, and every log any of the processes write.
.data/
*.log

# Secrets. .env.example is the documented template and is the one exception.
.env*
!.env.example
*.pem

# Python (Event Markets engine)
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
# Virtualenv for running the engine's tests on the host — see
# scripts/setup-engine.mjs. Never installed into the machine's Python.
.venv/

# macOS
.DS_Store

# dist-bundle is generated by `pnpm bundle` (scripts/bundle.mjs)
dist-bundle/

# Bundle builds use their own distDir so .next is never left standalone
.next-bundle/
