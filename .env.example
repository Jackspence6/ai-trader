# =============================================================================
# MERIDIAN — configuration
# =============================================================================
#
# Copy to `.env.local` and fill in. Every value below is documented with what
# happens if it is missing or wrong, because "unset" and "set to the wrong
# thing" fail very differently and only one of them is obvious.
#
# Nothing here is secret in this file. Never commit `.env.local`.
#
# Verify the result with `pnpm preflight`, which tries each of these rather than
# reading them.

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# The shared password for the console. A lock, not an account — it keeps the
# dashboard off the open internet and does not identify who signed in.
#
# MISSING: the console refuses to serve any page. It fails closed on purpose;
# a missing variable is the likeliest misconfiguration, and failing open would
# publish the dashboard.
SITE_PASSWORD=

# Postgres. `DB_URL` is accepted as an alias because the events engine has
# always used that name.
#
# MISSING: falls back to the Compose default below, which is right for a local
# bring-up and wrong for anything else.
# WRONG:   both desks write to a database nobody meant. Preflight prints the
#          database it actually reached — check that line, not this one.
DATABASE_URL=postgresql://trader:trader@localhost:5433/meridian

# -----------------------------------------------------------------------------
# EXECUTION — which money is at risk
# -----------------------------------------------------------------------------
#
# Two independent switches, and neither implies the other. This is deliberate:
# going live should require two deliberate acts on the machine that will trade.

# paper | testnet | live.
#
# MISSING or unrecognised: paper. Paper has to be opted out of, never into.
MERIDIAN_EXECUTION=paper

# The second switch. Required *in addition* for real-money orders.
#
# MISSING: mainnet orders are refused at three separate gates — the venue
#          resolver, the venue constructor, and every individual order.
ALLOW_MAINNET_TRADING=false

# -----------------------------------------------------------------------------
# ALERTS — optional, and the system is quieter without them
# -----------------------------------------------------------------------------

# @BotFather → /newbot → paste the token. Two minutes.
#
# MISSING: alerts are written to the log instead of sent. Nothing breaks; you
#          simply have to go and look.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# -----------------------------------------------------------------------------
# EVENT MARKETS — the sportsbook and prediction desk
# -----------------------------------------------------------------------------

# Gates the migration endpoint and manual scans.
# MISSING: those endpoints refuse every request. That is safe, not broken —
#          they never default open.
ADMIN_TOKEN=
# The scheduled scan authenticates with this.
CRON_SECRET=

# Detection thresholds. Raising them shows fewer, better opportunities; lowering
# them shows more, thinner ones. The defaults are the specification's.
SCAN_MIN_MARGIN_PCT=0.5
SCAN_MIN_EXECUTABLE_ZAR=2000
SCAN_TOTAL_STAKE_ZAR=10000
SCAN_MAX_MARKETS=120
# Assumed adverse price movement between seeing a price and getting it, in
# basis points. Set this too low and the board shows arbitrage that closes
# before you reach the second leg.
SCAN_SLIPPAGE_BPS=50

# Alert thresholds — separate from detection, so the board can show more than
# the phone does.
ALERT_MIN_MARGIN_PCT=0.8
ALERT_MIN_EXECUTABLE_ZAR=3000
ALERT_IMPROVEMENT_PP=0.3

# USD→ZAR conversion buffer for prediction-market legs, in percent. Covers the
# rand moving against you between placing and settling.
FX_BUFFER_PCT=2
# Used only when the FX provider is unreachable. A stale rate that pretends to
# be live is worse than an obviously fixed one.
FX_FALLBACK_USDZAR=
FX_PROVIDER_URL=

# Comma-separated Polymarket tag slugs to scan. Empty means the default set.
POLYMARKET_TAGS=
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# -----------------------------------------------------------------------------
# PATHS AND PORTS
# -----------------------------------------------------------------------------

# Where the recorder writes and where durable state lives. Defaults sit inside
# the project directory.
# WRONG: the recorder writes somewhere you will not think to back up, and every
#        day of missing capture is evidence that cannot be recovered later.
STATE_DIR=
RECORDINGS_DIR=
MIGRATIONS_DIR=

# The standalone kill switch listens here. It is a separate process so that
# halting still works when the console is the thing that is broken.
HALT_PORT=3999

# Encrypts exchange API credentials at rest.
# MISSING: credentials cannot be stored, so live trading cannot be configured.
#          Paper is unaffected.
VAULT_KEY=

# -----------------------------------------------------------------------------
# CONSOLE
# -----------------------------------------------------------------------------

# Simulated event-market opportunities, for demonstrating the interface without
# an engine behind it. The board watermarks itself when this is on.
# LEAVE UNSET for anything real. A board showing plausible arbitrage that does
# not exist is worse than a blank one.
NEXT_PUBLIC_DEMO=

# How often the event board polls, in milliseconds.
NEXT_PUBLIC_POLL_MS=6000
# Only needed when the events engine exposes a WebSocket on another host.
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DASHBOARD_URL=
