{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "record": "tsx scripts/record.ts",
    "record:stats": "tsx scripts/stats.ts",
    "test": "vitest run",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:import": "tsx scripts/db.ts import",
    "db:status": "tsx scripts/db.ts status",
    "halt": "tsx scripts/halt.ts halt",
    "halt:status": "tsx scripts/halt.ts status",
    "halt:resume": "tsx scripts/halt.ts resume",
    "halt:deadman": "tsx scripts/halt.ts deadman",
    "halt:server": "tsx scripts/halt-server.ts",
    "trade": "tsx scripts/trade.ts",
    "trade:once": "tsx scripts/trade.ts --once",
    "gen:migrations": "node scripts/gen-migrations.mjs",
    "prebuild": "node scripts/gen-migrations.mjs",
    "test:events": "node --experimental-strip-types --import ./scripts/events/ts-resolve.mjs ./scripts/events/check-arb-parity.mjs && node --experimental-strip-types --import ./scripts/events/ts-resolve.mjs ./scripts/events/test-polymarket-parsing.mjs && node --experimental-strip-types --import ./scripts/events/ts-resolve.mjs ./scripts/events/test-consistency.mjs && node --experimental-strip-types --import ./scripts/events/ts-resolve.mjs ./scripts/events/test-scanner.mjs",
    "test:engine": "node scripts/py.mjs",
    "test:all": "vitest run && pnpm test:events && pnpm test:engine",
    "preflight": "tsx scripts/preflight.ts",
    "setup:engine": "node scripts/setup-engine.mjs",
    "bundle": "node scripts/bundle.mjs",
    "self-update": "node scripts/update.mjs",
    "self-update:dry": "node scripts/update.mjs --dry-run"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@number-flow/react": "^0.6.2",
    "lightweight-charts": "^5.2.1",
    "motion": "^13.1.1",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
